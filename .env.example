NEXT_PUBLIC_GITHUB_OWNER=your-github-user-or-org
NEXT_PUBLIC_GITHUB_REPO=your-article-repository
NEXT_PUBLIC_GITHUB_BRANCH=main
NEXT_PUBLIC_GITHUB_ARTICLES_DIR=articles
NEXT_PUBLIC_GITHUB_ASSETS_DIR=assets

# Optional. Use only server-side on Vercel for higher GitHub API limits.
GITHUB_TOKEN=

# Optional authentication. Without these values, JSCR remains in public mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
ADMIN_EMAILS=your-admin-email@example.com
NEXT_PUBLIC_SITE_URL=https://www.jscr.in
